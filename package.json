{
  "name": "daisypatcher",
  "version": "0.1.0",
  "description": "Visual node-based patcher for the Electro-Smith Daisy Seed — emulate, compile, flash.",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "io.daisypatcher.app",
    "productName": "Daisypatcher",
    "directories": {
      "buildResources": "build-resources",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "AudioVideo;Audio"
    },
    "asarUnpack": [
      "**/node_modules/serialport/**",
      "**/node_modules/@serialport/**"
    ]
  },
  "dependencies": {
    "nanoid": "^5.1.9",
    "rete": "^2.0.6",
    "rete-area-plugin": "^2.1.5",
    "rete-connection-plugin": "^2.0.5",
    "rete-react-plugin": "^2.1.0",
    "rete-render-utils": "^2.0.3",
    "serialport": "^12.0.0",
    "styled-components": "^6.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
