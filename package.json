{
  "name": "daisypatcher",
  "version": "0.5.2",
  "description": "Visual node-based patcher for the Electro-Smith Daisy Seed and ESP32-S3/C3 — hear the patch in-app, compile it to firmware, flash the board.",
  "keywords": [
    "daisy-seed",
    "esp32",
    "esp32-s3",
    "esp32-c3",
    "dsp",
    "synthesizer",
    "eurorack",
    "node-editor",
    "patcher",
    "firmware",
    "daisysp",
    "libdaisy",
    "platformio",
    "electron"
  ],
  "author": {
    "name": "willbearfruits",
    "email": "willbear_fruits@proton.me"
  },
  "homepage": "https://willbearfruits.github.io/daisypatcher/",
  "repository": {
    "type": "git",
    "url": "https://github.com/willbearfruits/daisypatcher.git"
  },
  "bugs": {
    "url": "https://github.com/willbearfruits/daisypatcher/issues"
  },
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build:worklets": "node scripts/build-worklets.mjs",
    "predev": "npm run build:worklets",
    "prebuild": "npm run build:worklets",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:codegen": "node scripts/codegen-snapshot.mjs",
    "test:contract": "node scripts/codegen-contract.mjs",
    "test:compile": "node scripts/codegen-compile-harness.mjs",
    "test:audio": "node scripts/audio-parity.mjs",
    "test:features": "node scripts/feature-tests.mjs",
    "examples": "node scripts/build-examples.mjs",
    "examples:check": "node scripts/build-examples.mjs --check",
    "test": "npm run typecheck && npm run test:codegen && npm run test:contract",
    "dist": "npm run build:worklets && electron-vite build && electron-builder",
    "dist:linux": "npm run build:worklets && electron-vite build && electron-builder --linux",
    "dist:win": "npm run build:worklets && electron-vite build && electron-builder --win",
    "dist:all": "npm run build:worklets && electron-vite build && electron-builder -lw",
    "publish": "npm run build:worklets && electron-vite build && electron-builder --publish always"
  },
  "build": {
    "appId": "io.daisypatcher.app",
    "productName": "Daisypatcher",
    "directories": {
      "buildResources": "build-resources",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "dpatch",
        "name": "Daisypatcher Patch",
        "description": "Daisypatcher patch",
        "mimeType": "application/x-daisypatcher-patch",
        "role": "Editor"
      }
    ],
    "extraResources": [
      {
        "from": "examples",
        "to": "examples",
        "filter": [
          "*.dpatch",
          "README.md"
        ]
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "AudioVideo;Audio",
      "synopsis": "Visual node-based patcher for Daisy Seed and ESP32-S3/C3",
      "description": "Patch DSP graphs visually, hear them in-app, compile and flash to Electro-Smith Daisy Seed or ESP32-S3/C3.",
      "maintainer": "willbearfruits <willbear_fruits@proton.me>"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Daisypatcher",
      "uninstallDisplayName": "Daisypatcher ${version}"
    },
    "portable": {
      "artifactName": "Daisypatcher-${version}-portable.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "willbearfruits",
      "repo": "daisypatcher",
      "releaseType": "release"
    },
    "asarUnpack": [
      "**/node_modules/serialport/**",
      "**/node_modules/@serialport/**"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "nanoid": "^5.1.9",
    "rete": "^2.0.6",
    "rete-area-plugin": "^2.1.5",
    "rete-connection-plugin": "^2.0.5",
    "rete-react-plugin": "^2.1.0",
    "rete-render-utils": "^2.0.3",
    "serialport": "^12.0.0",
    "styled-components": "^6.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
