        "params": {
          "frequency": 110,
          "amplitude": 0.7,
          "waveform": "triangle"
        }
      },
      {
        "id": "code_2",
        "kind": "code",
        "position": {
          "x": -440,
          "y": -60
        },
        "params": {
          "source": "// Wavefolder — reflect at +/-1, three times.\n// p1 = drive, p2 = output level\nfloat x = a * p1;\nif (x > 1) { x = 2 - x; }\nif (x < -1) { x = -2 - x; }\nif (x > 1) { x = 2 - x; }\nif (x < -1) { x = -2 - x; }\nif (x > 1) { x = 2 - x; }\nif (x < -1) { x = -2 - x; }\nout = x * p2;",
          "p1": 3.2,
          "p2": 0.6,
          "p3": 0,
          "p4": 0
        }
      },
      {
        "id": "code_3",
        "kind": "code",
        "position": {
          "x": -180,
          "y": -60
        },
        "params": {
          "source": "// Bitcrush + downsample.\n// p1 = bit depth, p2 = hold length in samples\nstate float held = 0;\nstate float count = 0;\n\ncount = count + 1;\nif (count >= p2) {\n  count = 0;\n  float steps = pow(2, p1);\n  held = round(a * steps) / steps;\n}\nout = held;",
          "p1": 6,
          "p2": 8,
          "p3": 0,
          "p4": 0
        }
      },
      {
        "id": "filter_svf_4",
        "kind": "filter_svf",
        "position": {
          "x": 80,
          "y": -60
